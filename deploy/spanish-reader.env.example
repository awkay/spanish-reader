# /etc/spanish-reader.env  (owner root, group spanish-reader, mode 0640)
SR_LISTEN=127.0.0.1:8090
SR_DATA_DIR=/var/lib/spanish-reader

# The household access code. Changing it signs everyone out.
SR_ACCESS_CODE=CHANGE_ME

# AI: z.ai GLM Coding Plan via the Responses API (fastest; serves the model you ask for).
SR_AI_PROTOCOL=responses
SR_AI_BASE_URL=https://api.z.ai/api/v1
SR_AI_API_KEY=CHANGE_ME
SR_AI_MODEL=glm-5.3-flash
SR_AI_IMPROVE_MODEL=glm-5.3

# Text-to-speech (Piper + lame).
SR_PIPER_BIN=/opt/piper/piper/piper
SR_PIPER_MODEL=/opt/piper/voices/es_MX-claude-high.onnx
SR_LAME_BIN=/usr/bin/lame

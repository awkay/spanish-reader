# /etc/spanish-reader.env  (owner root, group spanish-reader, mode 0640)
SR_LISTEN=127.0.0.1:8090
SR_DATA_DIR=/var/lib/spanish-reader

# The household access code. Changing it signs everyone out.
SR_ACCESS_CODE=CHANGE_ME

# AI: z.ai GLM Coding Plan via the Responses API (fastest; serves the model you ask for).
SR_AI_PROTOCOL=responses
SR_AI_BASE_URL=https://api.z.ai/api/v1
SR_AI_API_KEY=CHANGE_ME
SR_AI_MODEL=glm-5.3-flash
SR_AI_IMPROVE_MODEL=glm-5.3
# Photo lessons (Android camera/gallery → POST /api/image): a model that accepts images. Default: SR_AI_MODEL
# (glm-5.3-flash reads images; glm-5.3 does not).
#SR_VISION_MODEL=glm-5.3-flash

# Text-to-speech (Piper + lame).
SR_PIPER_BIN=/opt/piper/piper/piper
SR_PIPER_MODEL=/opt/piper/voices/es_MX-claude-high.onnx
SR_LAME_BIN=/usr/bin/lame

# YouTube lessons (optional): an OpenAI-compatible /audio/transcriptions endpoint with word timestamps transcribes
# the audio and ffmpeg cuts it. Enabled when the key and model are set (plus ffmpeg).
# Where the audio comes from: the Android app downloads it on the phone and uploads it (POST /api/youtube/upload;
# needs only ffmpeg + ASR here, and the nginx upload location). yt-dlp serves only the web app (iPhone) and only
# works if YouTube doesn't block this server's IP; leave it unset/missing and the web app just can't import videos.
SR_YTDLP_BIN=/usr/local/bin/yt-dlp
SR_FFMPEG_BIN=/usr/bin/ffmpeg
SR_ASR_BASE_URL=https://openrouter.ai/api/v1
SR_ASR_API_KEY=
SR_ASR_MODEL=openai/whisper-large-v3
# Longest video accepted, and transcription minutes allowed per UTC day (caps spend if a token leaks). Both apply
# to uploads too; the upload size cap is ~1.25 MB per allowed minute (keep nginx's client_max_body_size above it).
SR_YT_MAX_MINUTES=60
SR_ASR_DAILY_MINUTES=180
# Only if YouTube starts asking the server to sign in: a cookies.txt exported from a browser.
#SR_YTDLP_COOKIES=/var/lib/spanish-reader/youtube-cookies.txt
